<?xml version="1.0" encoding="utf-8"?>
<!-- No INTERNET permission: LinkGuard never sends links anywhere. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the optional status notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets LinkGuard see installed browsers on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_shield"
        android:label="LinkGuard"
        android:theme="@style/Theme.LinkGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LinkActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.LinkGuard.Translucent">

            <!-- Makes LinkGuard appear in Settings > Default apps > Browser -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- "Share" a link to LinkGuard from apps that open links internally -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".StatusNotification"
            android:exported="false" />
    </application>
</manifest>
